---
import ToolCatalogue from '../../components/jupiter/ToolCatalogue.astro';
import { categoryDescriptions, categoryLabels, toolCategories, tools, type ToolCategory } from '../../data/tools';
import BaseLayout from '../../layouts/BaseLayout.astro';
export function getStaticPaths() { return toolCategories.map(category => ({ params: { category } })); }
const category = Astro.params.category as ToolCategory;
const title = `${categoryLabels[category]} tools`;
---
<BaseLayout title={title} description={categoryDescriptions[category]}>
  <main id="main-content" tabindex="-1" class="shell catalogue-main">
    <header class="hero"><p class="eyebrow">Text Utilities / {categoryLabels[category]}</p><h1>{title}</h1><p>{categoryDescriptions[category]}</p></header>
    <ToolCatalogue items={tools.filter(tool => tool.category === category)} />
  </main>
</BaseLayout>
