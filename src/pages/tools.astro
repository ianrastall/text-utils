---
import ToolCatalogue from '../components/jupiter/ToolCatalogue.astro';
import { tools } from '../data/tools';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="All tools">
  <main id="main-content" tabindex="-1" class="shell catalogue-main">
    <header class="hero"><h1>All tools</h1></header>
    <ToolCatalogue items={tools} />
  </main>
</BaseLayout>
