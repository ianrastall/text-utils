---
import ToolCatalogue from '../components/jupiter/ToolCatalogue.astro';
import { tools } from '../data/tools';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="All tools">
  <main id="main-content" tabindex="-1" class="shell catalogue-main">
    <header class="hero"><p class="eyebrow">Your everyday text toolkit</p><h1>Text Utilities</h1><p>Write, convert, inspect, and design.<br />Useful little tools, ready when you need them.</p></header>
    <ToolCatalogue items={tools} />
  </main>
</BaseLayout>
