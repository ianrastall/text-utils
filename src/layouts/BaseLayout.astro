---
import '../styles/global.css';
import 'material-symbols/index.css';
import { ArrowRightLeft, LayoutGrid, PencilLine, ScanSearch, Palette, ArrowUpRight } from '@lucide/astro';
import Appearance from '../components/jupiter/Appearance.astro';
import { tools, toolCategories, categoryLabels, categoryHref } from '../data/tools';
interface Props { title: string; description?: string; editorWorkspace?: boolean; }
const { title, editorWorkspace = false, description = 'Browser tools for writing, converting, inspecting, and designing text.' } = Astro.props;
const pageTitle = title === 'Text Utilities' ? title : `${title} · Text Utilities`;
const currentPath = Astro.url.pathname.replace(/\/index\.html$/, '/');
const currentTool = tools.find(tool => tool.href === currentPath || tool.href.replace('.html', '') === currentPath);
const externalNotes: Record<string, string> = {
  'font-chooser': 'Google Fonts previews load font files from Google. Choose system fonts to work without those requests.',
  'google-icons-chooser': 'Icon previews load Material Symbols fonts from Google.',
  'ip-info': 'This tool contacts IP lookup services and Google DNS to retrieve network details.',
  'grateful-dead-archive': 'Searches are sent to the Internet Archive. Results and recordings require a connection.',
  'xml-sitemap-generator': 'Pasted URL lists are processed locally. Crawling contacts the URLs you choose and any proxy you provide.'
};
const externalNote = currentTool && externalNotes[currentTool.id];
const icons = { write: PencilLine, convert: ArrowRightLeft, inspect: ScanSearch, design: Palette };
---
<!doctype html>
<html lang="en" data-theme="dark" data-editor-workspace={editorWorkspace ? "true" : undefined}>
  <head>
    <script is:inline define:vars={{ analyticsPageTitle: pageTitle }}>
      if (window.self === window.top && new URLSearchParams(location.search).get('embed') !== '1') {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', 'G-29350EGFR5', { page_title: analyticsPageTitle });
        const tag = document.createElement('script');
        tag.async = true;
        tag.src = 'https://www.googletagmanager.com/gtag/js?id=G-29350EGFR5';
        document.head.append(tag);
      }
    </script>
    <meta charset="UTF-8" />
    {editorWorkspace && <meta http-equiv="Content-Security-Policy" content="img-src 'self' data: blob:; object-src 'none'; base-uri 'self'" />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
    <script is:inline>
      if (window.self !== window.top && new URLSearchParams(location.search).get('embed') === '1') document.documentElement.dataset.embedded = 'true';
      try {
        const theme = localStorage.getItem('text-utils-theme');
        document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
        const accent = localStorage.getItem('text-utils-accent');
        if (accent && /^#[0-9a-f]{6}$/i.test(accent)) document.documentElement.style.setProperty('--accent', accent);
      } catch { /* Browser storage is optional. */ }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Text Utilities home"><span class="brand-mark" aria-hidden="true">T<span>_</span></span><span>Text Utilities<small>A Jupiter project</small></span></a>
      <nav class="site-network" aria-label="Jupiter websites"><a class="network-current" href="/" aria-current="true">Text Utilities</a><a href="https://chessnerd.net">Chess Nerd <ArrowUpRight size={13} aria-hidden="true" /></a><a href="https://bookstacks.org">Bookstacks <ArrowUpRight size={13} aria-hidden="true" /></a></nav>
      <Appearance />
    </header>
    <div class="workspace">
      {!editorWorkspace && <aside class="sidebar" aria-label="Tool navigation">
        <a class="editor-return" href="/">← Text editor</a><p class="eyebrow">Tools</p>
        <nav class="workspace-nav" aria-label="Tool categories">
          <a href="/tools.html" class:list={[{ active: currentPath === '/tools.html' }]} aria-current={currentPath === '/tools.html' ? 'page' : undefined}><LayoutGrid size={17} aria-hidden="true" />All tools<span class="nav-count">{tools.length}</span></a>
          {toolCategories.map(category => { const Icon = icons[category]; const active = currentPath === categoryHref(category) || currentPath === categoryHref(category).replace('.html', '') || currentTool?.category === category; return <a href={categoryHref(category)} class:list={[{ active }]} aria-current={active ? 'true' : undefined}><Icon size={17} aria-hidden="true" />{categoryLabels[category]}<span class="nav-count">{tools.filter(tool => tool.category === category).length}</span></a>; })}
        </nav>
        {currentTool && <div class="related-nav"><p class="eyebrow">{categoryLabels[currentTool.category]} tools</p><nav aria-label="Related tools">{tools.filter(tool => tool.category === currentTool.category).map(tool => <a href={tool.href} aria-current={currentTool.id === tool.id ? 'page' : undefined}>{tool.name}</a>)}</nav></div>}
        <div class="sidebar-note"><span class="local-indicator" aria-hidden="true"></span><strong>Processing</strong><p>Most tools work entirely in your browser. Tools using online services say so.</p></div>
      </aside>}
      <div class="workspace-content">
        <noscript><p class="shell notice">JavaScript is off. Interactive tools and appearance settings require JavaScript. <a href="/tools.html">Browse the tool directory</a>.</p></noscript>
        {externalNote && <p class="shell external-notice">{externalNote}</p>}
        <slot />
        <footer class="site-footer shell"><div><strong>Text Utilities</strong></div><nav aria-label="Project links"><a href="https://github.com/ianrastall/text-utils">Source on GitHub <ArrowUpRight size={14} aria-hidden="true" /></a><a href="https://ko-fi.com/ianrastall">Support this project <ArrowUpRight size={14} aria-hidden="true" /></a></nav></footer>
      </div>
    </div>
  </body>
</html>
