---
import { languageOptions } from '../lib/workspace-languages';
import { operationGroups } from '../lib/workspace-operations';
import { tools, categoryLabels, toolCategories } from '../data/tools';
import { FilePlusCorner, FolderOpen, Download, Undo2, Redo2, Search, SlidersHorizontal, PanelRightClose, BookOpen, Puzzle, ArrowUpRight } from '@lucide/astro';
const menus = [
  { name:'File', items:[['new','New document'],['open','Open files…'],['save','Download document'],['rename','Rename document…'],['duplicate','Duplicate document'],['close-document','Close document']] },
  { name:'Edit', items:[['undo','Undo'],['redo','Redo'],['find','Find and replace…'],['select-all','Select all'],['copy','Copy document or selection']] },
  { name:'Text', items:[['transform','Text operations…'],['cleanup','Clean up lines…'],['case','Change letter case…'],['regex','Regex replace or extract…'],['format-json','Format JSON…'],['format-markdown','Format Markdown…']] },
  { name:'Insert', items:[['tool:unicode-chooser','Unicode characters…'],['tool:font-awesome-chooser','Font Awesome icons…'],['tool:google-icons-chooser','Google icons…'],['tool:code-snippets','Code snippets…'],['tool:lorem-ipsum','Placeholder text…'],['tool:sequence-generator','Sequence…'],['tool:random-numbers','Random numbers…']] },
  { name:'View', items:[['markdown','Markdown preview'],['compare','Compare documents…'],['wrap','Toggle word wrap'],['zoom-in','Increase text size'],['zoom-out','Decrease text size'],['close-panel','Close side panel']] },
  { name:'Tools', items:[['browse-tools','Browse all tools…'],['tool:color-chooser','Color picker…'],['tool:font-chooser','Font picker…'],['tool:css-gradient-generator','Gradient designer…'],['tool:json-tools','Advanced JSON tools…'],['tool:gutenberg-cleaner','Gutenberg cleaner…'],['help','Workspace help']] }
];
---
<main id="main-content" tabindex="-1" class="editor-workspace" aria-label="Text editor workspace" aria-busy="true" inert>
  <h1 class="visually-hidden">Free online text editor</h1>
  <nav class="editor-menubar" aria-label="Editor menus">
    {menus.map(menu => <details class="editor-menu"><summary>{menu.name}</summary><div class="editor-menu-items">{menu.items.map(([id,label]) => <button type="button" data-action={id}>{label}</button>)}</div></details>)}
    <span class="editor-privacy">Free · text stays in your browser</span>
  </nav>
  <div class="editor-toolbar" role="toolbar" aria-label="Document commands">
    <button type="button" data-action="new" title="New document"><FilePlusCorner size={17} aria-hidden="true" /><span>New</span></button>
    <button type="button" data-action="open" title="Open files (Ctrl+O)"><FolderOpen size={17} aria-hidden="true" /><span>Open</span></button>
    <button type="button" data-action="save" title="Download document (Ctrl+S)"><Download size={17} aria-hidden="true" /><span>Download</span></button>
    <span class="toolbar-divider"></span>
    <button type="button" data-action="undo" aria-label="Undo" title="Undo (Ctrl+Z)"><Undo2 size={17} aria-hidden="true" /></button>
    <button type="button" data-action="redo" aria-label="Redo" title="Redo (Ctrl+Shift+Z)"><Redo2 size={17} aria-hidden="true" /></button>
    <button type="button" data-action="find" title="Find and replace (Ctrl+F)"><Search size={17} aria-hidden="true" /><span>Find</span></button>
    <div class="toolbar-spacer"></div>
    <button type="button" data-action="transform"><SlidersHorizontal size={17} aria-hidden="true" /><span>Text tools</span></button>
    <button type="button" data-action="browse-tools"><Puzzle size={17} aria-hidden="true" /><span>All tools</span></button>
    <button type="button" data-action="markdown" title="Markdown preview"><BookOpen size={17} aria-hidden="true" /><span>Preview</span></button>
  </div>
  <input id="workspace-files" type="file" multiple hidden aria-label="Open UTF-8 text files" />
  <div class="document-strip"><div id="document-tabs" role="tablist" aria-label="Open documents"></div><button type="button" data-action="new" aria-label="Add document">+</button></div>
  <div class="editor-body" id="editor-body">
    <section class="document-area" aria-label="Active document"><div id="document-editor"></div><div id="editor-loading">Loading editor…</div></section>
    <aside class="work-panel" id="work-panel" aria-labelledby="work-panel-title" hidden>
      <header class="work-panel-header"><h2 id="work-panel-title">Text operations</h2><button type="button" class="expand-tool" data-action="expand-tool" aria-pressed="false">Expand</button><button type="button" data-action="close-panel" aria-label="Close side panel"><PanelRightClose size={18} aria-hidden="true" /></button></header>
      <section id="transform-panel" class="work-panel-content" hidden>
        <div class="work-field"><label for="operation-scope">Apply to</label><select id="operation-scope"><option value="document">Whole document</option><option value="selection">Selected text</option></select></div>
        <div class="work-field"><label for="operation-choice">Operation</label><select id="operation-choice">{operationGroups.map(group => <optgroup label={group.name}>{group.items.map(([id,label]) => <option value={id}>{label}</option>)}</optgroup>)}</select></div>
        <div id="regex-options" hidden>
          <div class="work-field"><label for="operation-pattern">Regular expression</label><input id="operation-pattern" type="text" placeholder="pattern" spellcheck="false" /></div>
          <div class="work-field"><label for="operation-flags">Flags</label><input id="operation-flags" type="text" value="g" spellcheck="false" /></div>
          <div class="work-field"><label for="operation-replacement">Replacement ($1, $2…)</label><input id="operation-replacement" type="text" spellcheck="false" /></div>
          <div class="work-field"><label for="operation-group">Extract capture group (optional)</label><input id="operation-group" type="number" min="0" placeholder="Full match" /></div>
        </div>
        <div class="work-actions"><button id="preview-operation" type="button" class="primary">Preview changes</button><button id="cancel-operation" type="button" hidden>Cancel</button><button id="add-recipe-step" type="button">Add to recipe</button></div>
        <details id="recipe-details"><summary>Operation recipe <span id="recipe-count"></span></summary><ol id="recipe-steps"></ol><div class="work-actions"><button id="preview-recipe" type="button">Preview recipe</button><button id="clear-recipe" type="button">Clear steps</button></div><div class="work-field"><label for="recipe-name">Recipe name</label><input id="recipe-name" type="text" maxlength="80" placeholder="My cleanup" /></div><div class="work-actions"><button id="save-recipe" type="button">Save recipe</button></div><div class="work-field"><label for="saved-recipe">Saved recipes</label><select id="saved-recipe"><option value="">Choose a recipe</option></select></div><div class="work-actions"><button id="load-recipe" type="button">Load</button><button id="delete-recipe" type="button">Delete recipe</button></div></details>
        <div id="operation-preview" hidden><div class="preview-label">Result preview <span id="preview-size"></span></div><pre id="operation-result"></pre><div class="work-actions"><button id="apply-operation" type="button" class="primary">Apply changes</button><button id="result-as-document" type="button">Open as document</button></div></div>
        <p class="work-hint">Changes apply as one undo step. Your text is processed on this device.</p>
      </section>
      <section id="markdown-panel" class="work-panel-content" hidden><p class="work-hint">Live preview of the active document. Remote images are blocked.</p><article id="workspace-markdown" class="workspace-markdown"></article></section>
      <section id="compare-panel" class="work-panel-content" hidden><div class="work-field"><label for="compare-document">Compare with</label><select id="compare-document"></select></div><p id="compare-summary" class="work-hint"></p><div id="workspace-diff" aria-label="Document differences"></div></section>
      <section id="browse-panel" class="work-panel-content" hidden><div class="work-field"><label for="workspace-tool-search">Find a tool</label><input id="workspace-tool-search" type="search" placeholder="Name or task…" /></div><div id="workspace-tool-list">{toolCategories.map(category => <section class="tool-list-group"><h3>{categoryLabels[category]}</h3>{tools.filter(t => t.category === category).map(tool => <button type="button" data-action={`tool:${tool.id}`} data-tool-search={`${tool.name} ${tool.description}`.toLowerCase()}><span>{tool.name}</span><span class="tool-description">{tool.description}</span></button>)}</section>)}</div><p id="workspace-tools-empty" hidden>No matching tools.</p><a href="/tools.html">Open the tool directory <ArrowUpRight size={13} aria-hidden="true" /></a></section>
      <section id="specialist-panel" hidden>
        <div class="specialist-controls"><p id="tool-network-note" class="work-hint"></p><div class="work-field"><label for="tool-input-field">Input field</label><select id="tool-input-field"></select></div><button id="send-to-tool" type="button">Use document or selection as input</button><div class="work-field"><label for="tool-output-field">Result field</label><select id="tool-output-field"></select></div><details class="tool-result-details"><summary>Selected result preview</summary><label class="visually-hidden" for="tool-result-preview">Selected tool result</label><textarea id="tool-result-preview" readonly spellcheck="false"></textarea><p class="work-hint" id="tool-result-size"></p></details><div class="work-actions"><button id="insert-tool-result" type="button" class="primary">Insert result</button><button id="tool-result-document" type="button">New document from result</button></div><a id="standalone-tool" href="/tools.html" target="_blank" rel="noopener">Open separately ↗</a></div>
        <iframe id="specialist-frame" title="Specialist tool" loading="lazy" sandbox="allow-scripts allow-same-origin allow-forms allow-downloads allow-popups" referrerpolicy="same-origin"></iframe>
      </section>
      <section id="help-panel" class="work-panel-content" hidden>
        <a href="/editor-third-party-notices.txt" target="_blank" rel="noopener">Editor software notices</a>
        <h3>A text editor with tools built in</h3><p>Open a UTF-8 text file or start typing. Use Text tools on the whole document or a selection, preview the result, then apply. Undo covers editing and transformations.</p><p>Insert opens character, icon and snippet pickers beside your document. All tools includes the full original collection. Choose a result field and insert its contents at the cursor or replace selected text.</p><p>Use Markdown preview for a rendered view, or Compare documents for differences between tabs. File → Download saves a UTF-8 copy; it does not overwrite the file you opened.</p><p>Ctrl/Cmd+O opens files. Ctrl/Cmd+S downloads. Ctrl/Cmd+F opens find/replace. Ctrl/Cmd+Z undoes. Shift+Ctrl/Cmd+Z redoes. Press Escape, then Tab to leave the editor using the keyboard.</p><p>Draft recovery is optional and off initially. Enabling it stores documents in this browser on this device. Browser cleanup can remove them; keep important work in downloaded files. Recovered text starts a fresh undo history.</p><button id="load-example" type="button">Open a cleanup example</button><a href="/tools.html">Browse tool directory</a>
      </section>
    </aside>
  </div>
  <footer class="editor-statusbar"><span id="document-stats">0 words · 0 characters</span><span id="selection-stats"></span><span class="toolbar-spacer"></span><label for="document-language" class="visually-hidden">Document language</label><select id="document-language" title="Highlighting language"><option value="auto">Automatic</option>{languageOptions.map(([id,name]) => <option value={id}>{name}</option>)}</select><span id="language-status" aria-live="polite">Plain text · auto</span><label for="document-eol" class="visually-hidden">Line endings</label><select id="document-eol" title="Download line endings"><option value="lf">LF</option><option value="crlf">CRLF</option><option value="cr">CR</option></select><span>UTF-8</span></footer>
  <div class="workspace-bottom"><p id="workspace-status" role="status" aria-live="polite">Ready. Open a file or start typing.</p><label class="draft-preference"><input id="remember-drafts" type="checkbox" /> Remember drafts on this device</label><button id="forget-drafts" type="button">Erase saved drafts</button><button type="button" data-action="help">Help</button></div>
  <dialog id="rename-dialog" aria-labelledby="rename-title"><form id="rename-form"><h2 id="rename-title">Rename document</h2><label for="document-name">File name</label><input id="document-name" type="text" required maxlength="180" /><div class="work-actions"><button class="primary" type="submit">Rename</button><button type="button" id="rename-cancel">Cancel</button></div></form></dialog>
  <noscript><p>The editor needs JavaScript. The <a href="/tools.html">tool directory</a> remains available to browse.</p></noscript>
</main>
<script src="../scripts/editor-workspace.ts"></script>
